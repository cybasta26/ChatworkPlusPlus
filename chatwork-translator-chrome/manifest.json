{
  "manifest_version": 3,
  "name": "__MSG_ext_name__",
  "version": "1.24.32",
  "description": "__MSG_ext_description__",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms"
  ],
  "host_permissions": [
    "https://translate.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_ext_name__"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.chatwork.com/*",
        "https://kcw.kddi.ne.jp/*"
      ],
      "js": [
        "i18n.js",
        "auto-settings.js",
        "names.js",
        "google-client.js",
        "content.js",
        "mentions-core.js",
        "vendor/html2canvas.min.js",
        "thread-image.js",
        "mentions.js",
        "screenshot-attachment.js",
        "ad-hider.js",
        "room-titles.js",
        "archive-source.js",
        "archive-sidebar.js"
      ],
      "css": [
        "content.css",
        "mentions.css",
        "room-titles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "default_locale": "en",
  "web_accessible_resources": [
    {
      "resources": [
        "archive.html"
      ],
      "matches": [
        "https://www.chatwork.com/*",
        "https://kcw.kddi.ne.jp/*"
      ]
    }
  ]
}
